# .env
# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o arquivo .env para o Git

# ID do fluxo Typebot (encontrado na URL do seu bot)
TYPEBOT_ID=edubot-uscs-1m67yud

# Porta do servidor de funções Netlify (padrão: 9999)
# Usada pelo comando: netlify functions:serve
FUNCTIONS_PORT=9999
